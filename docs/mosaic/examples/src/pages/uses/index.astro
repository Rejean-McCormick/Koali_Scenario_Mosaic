---
import { getCollection } from 'astro:content';
import UsageMosaic from '../../components/UsageMosaic.astro';
import ScenarioPreview from '../../components/ScenarioPreview.astro';

const scenarios = await getCollection('scenarios');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Koali Use Mosaic</title>
  </head>
  <body>
    <main>
      <ScenarioPreview />
      <UsageMosaic scenarios={scenarios} />
    </main>
  </body>
</html>
