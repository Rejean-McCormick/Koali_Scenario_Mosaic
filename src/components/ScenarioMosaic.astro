---
import ScenarioCell from './ScenarioCell.astro';import ScenarioPreview from './ScenarioPreview.astro';import MosaicControls from './MosaicControls.astro';import layout from '../data/mosaic-layout.json';import {getPublicActivities,humanizePublicValue} from '../lib/public-profile';import {resolveScenarioPreviewImage} from '../lib/scenario-image';const {scenarios}=Astro.props;const byId=Object.fromEntries(scenarios.map((e:any)=>[e.data.id,e]));const previewData=Object.fromEntries(scenarios.map((e:any)=>{const scales=(e.data.scales??[]).map(humanizePublicValue);const contexts=[...new Set([...(e.data.settings??[]),...(e.data.domains??[])])].map(humanizePublicValue).slice(0,3);return [e.data.id,{id:e.data.id,title:e.data.title,category:e.data.category_label,categoryId:e.data.primary_category,pattern:e.data.pattern_label,summary:e.data.preview_summary,palette:e.data.palette,activities:getPublicActivities(e.data.palette),scales,contexts,properties:(e.data.properties??[]).map(humanizePublicValue),image:resolveScenarioPreviewImage(e.data.id,e.data.preview_image),imageAlt:e.data.preview_image_alt,href:`/uses/${e.data.id}/`,search:[e.data.title,e.data.category_label,e.data.pattern_label,...e.data.palette,...e.data.scales,...e.data.settings,...e.data.properties,...e.data.domains].join(' ').toLowerCase()}]}));
---
<div class="mosaic-experience" data-mosaic-root><ScenarioPreview total={scenarios.length}/><MosaicControls total={scenarios.length}/><div class="mosaic-stage"><svg class="mosaic" viewBox={layout.viewBox.join(' ')}>{Object.entries(layout.assignments).map(([scenarioId,slotId])=>{const e:any=byId[scenarioId];const s:any=(layout.slots as any)[slotId];return <ScenarioCell id={scenarioId} title={e.data.title} category={e.data.primary_category} href={`/uses/${scenarioId}/`} x={s.x} y={s.y} size={s.size}/>})}</svg><p class="mosaic-hint">One cell at a time. Regular honeycomb grid.</p></div><script type="application/json" data-mosaic-data set:html={JSON.stringify(previewData).replace(/</g,'\u003c')}></script></div><script>import '../scripts/mosaic.ts';</script>
