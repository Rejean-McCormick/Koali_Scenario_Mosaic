---
const {total=120}=Astro.props;
---
<div class="mosaic-controls"><label class="search-box"><span class="sr-only">Search scenarios</span><input data-mosaic-search type="search" placeholder="Search the mosaic…" /></label><button class="ghost-button" data-mosaic-surprise>Surprise me</button><button class="ghost-button" data-mosaic-reset>Reset</button><output data-mosaic-result-count>{total} scenarios</output></div>
