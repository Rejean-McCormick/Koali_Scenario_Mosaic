---
import { getUi, type Locale } from '../i18n/ui';
const { total = 120, locale = 'en' as Locale } = Astro.props;
const s = getUi(locale);
---
<div class="mosaic-controls">
  <label class="search-box"><span class="sr-only">{s.searchScenarios}</span><input data-mosaic-search type="search" placeholder={s.searchPlaceholder} /></label>
  <button class="ghost-button" data-mosaic-surprise>{s.surprise}</button>
  <button class="ghost-button" data-mosaic-reset>{s.reset}</button>
  <output data-mosaic-result-count>{total} {s.scenarios}</output>
</div>
