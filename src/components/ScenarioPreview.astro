---
import { getUi, humanizeTag, type Locale } from '../i18n/ui';
import { resolveScenarioPreviewImageSet } from '../lib/scenario-image';
import { paletteBacklightGroups } from '../lib/palette-icons';
import { getScenarioPortal } from '../lib/scenario-portal';

const {
  total = 120,
  locale = 'en' as Locale,
  scenario = null,
} = Astro.props;

const s = getUi(locale);
const selected = Boolean(scenario);
const data = scenario?.data;
const body = scenario?.entry?.body ?? '';
const portal = selected ? getScenarioPortal(data, body, locale) : null;
const scales = selected ? (data.scales ?? []).map((x:string) => humanizeTag(locale, x)) : [];
const contexts = selected ? [...new Set([
  ...(data.settings ?? []),
  ...(data.domains ?? []),
])].map((x:string) => humanizeTag(locale, x)).slice(0, 3) : [];
const properties = selected ? (data.properties ?? []).map((x:string) => humanizeTag(locale, x)) : [];
const image = selected ? resolveScenarioPreviewImageSet(data.id, data.preview_image) : null;
const paletteKeys = selected ? (data.palette ?? []) : [];
const paletteBacklights = paletteBacklightGroups.map((group) => ({
  ...group,
  active: selected && group.palette.some((key) => paletteKeys.includes(key)),
  label: group.label[locale],
  iconPath: `/icons/palette/${group.icon}`,
  architectureLabel: group.architecture.join(' · '),
}));
const titleText = selected ? portal!.capabilityTitle : s.exploreWays(total);
---
<section class="scenario-preview" data-preview-swipe={!selected ? 'true' : undefined} data-preview-selected={selected ? 'true' : 'false'}>
  <div class="preview-image-shell" data-preview-media>
    <img
      class="preview-home-logo"
      data-preview-prompt
      src="/brand/koali-mark.svg"
      alt="Koali"
      style="width:72%;height:72%;object-fit:contain;place-self:center"
      hidden={selected}
    />
    <img
      data-preview-image
      data-image-state={selected ? 'scenario' : 'empty'}
      src={image?.src ?? undefined}
      srcset={image?.srcset}
      sizes={image?.sizes}
      alt={selected ? data.preview_image_alt : ''}
      hidden={!selected}
    />
  </div>

  <div class="preview-copy">
    <p class="preview-eyebrow">
      <span data-preview-id>{selected ? data.id : (locale === 'fr' ? 'Mosaïque de scénarios Koali' : 'Koali Scenario Mosaic')}</span>
      <span aria-hidden="true"> · </span>
      <span data-preview-category>{selected ? data.category_label : `${total} ${s.examples}`}</span>
    </p>

    <h1 data-preview-title>{titleText}</h1>
    <p class="preview-summary" data-preview-summary>{selected ? portal!.koaliHelp : s.hoverIntro}</p>

    <p class="preview-example" data-preview-example-wrap hidden={!selected}>
      <span>{s.exampleLabel}</span>
      <strong data-preview-example>{selected ? portal!.exampleTitle : ''}</strong>
    </p>

    <div class="preview-tags preview-backlights" data-preview-palette>
      {paletteBacklights.map((item) => (
        <span
          class:list={['tag', 'tag-backlight', {'is-active': item.active}]}
          data-backlight-key={item.key}
          data-architecture={item.architectureLabel}
          title={`${item.label} — ${s.usuallyVia}: ${item.architectureLabel}`}
          aria-label={`${item.label}: ${item.active ? (locale === 'fr' ? 'actif' : 'active') : (locale === 'fr' ? 'inactif' : 'inactive')}. ${s.usuallyVia}: ${item.architectureLabel}`}
        >
          <img class="tag-icon" src={item.iconPath} alt="" aria-hidden="true" />
          <span class="tag-label">{item.label}</span>
        </span>
      ))}
    </div>

    {selected
      ? <a class="preview-cta" href={`/${locale}/uses/`}>← {s.detailBack}</a>
      : <a class="preview-cta touch-full-link" data-preview-link hidden>
          {s.openExample}
          <span aria-hidden="true"> →</span>
        </a>}
  </div>

  <aside class="preview-profile" data-preview-profile data-category={selected ? data.primary_category : undefined}>
    <div class="profile-heading">
      <span class="profile-title">{s.insideKoali}</span>
      <span class="profile-section-label">{s.systemPath}</span>
    </div>

    <div class="profile-systems" data-preview-systems>
      <div class="system-route-list" data-preview-system-list>
        {selected
          ? portal!.systems.map((system) => (
              <span class="system-route" title={system.description} data-system-key={system.key}>
                <strong>{system.label}</strong>
                <small>{system.description}</small>
              </span>
            ))
          : <span class="system-route-empty">{s.selectSystemHint}</span>}
      </div>
    </div>

    <div class="profile-context">
      <div><span>{s.scale}</span><strong data-preview-scales>{selected ? scales.join(' · ') : '—'}</strong></div>
      <div><span>{s.context}</span><strong data-preview-context>{selected ? contexts.join(' · ') : '—'}</strong></div>
      <div><span>{s.specialConditions}</span><strong data-preview-properties>{selected ? (properties.join(' · ') || s.noneHighlighted) : s.noneHighlighted}</strong></div>
    </div>
  </aside>
</section>
<script>
  import '../scripts/preview-layout.ts';
</script>
