---
import { getUi, type Locale } from '../i18n/ui';
const { total = 120, locale = 'en' as Locale } = Astro.props;
const s = getUi(locale);
---
<section class="scenario-preview">
  <div class="preview-image-shell">
    <img data-preview-image data-image-state="cover" src={locale === 'fr' ? '/mosaic-cover-fr.svg' : '/mosaic-cover.svg'} alt={locale === 'fr' ? 'Aperçu de la Mosaïque de scénarios Koali' : 'Koali Scenario Mosaic scenario preview'} />
  </div>
  <div class="preview-copy">
    <p class="preview-eyebrow"><span data-preview-id>{locale === 'fr' ? 'Mosaïque de scénarios Koali' : 'Koali Scenario Mosaic'}</span> · <span data-preview-category>{total} {s.scenarios}</span></p>
    <h1 data-preview-title>{s.exploreWays(total)}</h1>
    <p class="preview-summary" data-preview-summary>{s.hoverIntro}</p>
    <div class="preview-tags" data-preview-palette><span class="tag">{s.hoverHint}</span></div>
    <a class="preview-cta" data-preview-link hidden>{s.readScenario} →</a>
  </div>
  <aside class="preview-profile" data-preview-profile>
    <div class="profile-heading"><span class="profile-title">{s.scenarioProfile}</span><span class="profile-category"><span class="category-swatch"></span><strong data-preview-category-label>{s.exploreMosaic}</strong></span></div>
    <div class="profile-pattern"><span>{s.typicalMotion}</span><small data-preview-pattern>{s.hoverInspect}</small></div>
    <div class="profile-actions"><span class="profile-section-label">{s.whatHappens}</span><div class="activity-signature">
      <span data-activity="understand"><i></i>{s.activityLabels.understand}</span>
      <span data-activity="learn"><i></i>{s.activityLabels.learn}</span>
      <span data-activity="create"><i></i>{s.activityLabels.create}</span>
      <span data-activity="decide"><i></i>{s.activityLabels.decide}</span>
      <span data-activity="act"><i></i>{s.activityLabels.act}</span>
      <span data-activity="respond"><i></i>{s.activityLabels.respond}</span>
      <span data-activity="remember"><i></i>{s.activityLabels.remember}</span>
    </div></div>
    <div class="profile-context"><div><span>{s.scale}</span><strong data-preview-scales>—</strong></div><div><span>{s.context}</span><strong data-preview-context>—</strong></div><div><span>{s.specialConditions}</span><strong data-preview-properties>{s.noneHighlighted}</strong></div></div>
  </aside>
</section>
