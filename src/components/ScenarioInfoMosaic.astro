---
import { getUi, humanizeTag, localizeEntryTrigger, type Locale } from '../i18n/ui';
import { extractScenarioPublicDetails } from '../lib/scenario-public';
import { getScenarioPortal } from '../lib/scenario-portal';

const { scenario, locale = 'en' as Locale } = Astro.props;
const s = getUi(locale);
const details = extractScenarioPublicDetails(scenario.entry.body ?? '', locale);
const portal = getScenarioPortal(scenario.data, scenario.entry.body ?? '', locale);
const transfer = (scenario.data.transfer_domains ?? []).map((x:string) => humanizeTag(locale, x));
const flowFallback = scenario.data.pattern;
---
<section class="scenario-info-mosaic" data-category={scenario.data.primary_category} aria-label={locale === 'fr' ? 'Fonctionnement public de Koali dans cet exemple' : 'How Koali works in this example'}>
  <article class="detail-hex detail-hex--trigger">
    <div class="detail-hex-inner">
      <span>{s.detailStartsWith}</span>
      <strong>{localizeEntryTrigger(locale, scenario.data.entry_trigger)}</strong>
    </div>
  </article>

  <article class="detail-hex detail-hex--mechanism">
    <div class="detail-hex-inner">
      <span>{s.detailWhatGetsLost}</span>
      <p>{scenario.data.pattern}</p>
    </div>
  </article>

  <article class="detail-hex detail-hex--systems">
    <div class="detail-hex-inner">
      <span>{s.detailKoaliContinuity}</span>
      <div class="detail-system-list">
        {portal.systems.map((system) => (
          <strong title={system.description}>{system.label}</strong>
        ))}
      </div>
    </div>
  </article>

  <article class="detail-hex detail-hex--flow">
    <div class="detail-hex-inner">
      <span>{s.detailFlow}</span>
      <p class="detail-flow">{details.flow || flowFallback}</p>
    </div>
  </article>

  <article class="detail-hex detail-hex--transfer">
    <div class="detail-hex-inner">
      <span>{s.detailTransferable}</span>
      <strong>{transfer.join(' · ')}</strong>
    </div>
  </article>
</section>
