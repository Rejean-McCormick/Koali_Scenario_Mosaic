---
const {id,title,category,href,x,y,size,thumbnail=null}=Astro.props;
const pts=Array.from({length:6},(_,i)=>{const a=Math.PI/3*i-Math.PI/6;return `${x+size*Math.cos(a)},${y+size*Math.sin(a)}`}).join(' ');
---
<a class={`mosaic-cell ${category.toLowerCase()}`} href={href} data-scenario-id={id} aria-label={`${id}: ${title}`} tabindex="0">
  {thumbnail && (
    <image
      class="mosaic-cell-thumbnail"
      href={thumbnail}
      x={x-size}
      y={y-size}
      width={size*2}
      height={size*2}
      preserveAspectRatio="xMidYMid slice"
      clip-path="url(#mosaic-thumbnail-clip)"
      aria-hidden="true"
    />
  )}
  <polygon points={pts}/>
  <title>{`${id}: ${title}`}</title>
</a>
