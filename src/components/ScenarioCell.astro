---
import { categoryMeta } from '../data/categories';
interface Props { id:string; title:string; href:string; category:string; x:number; y:number; size:number; related:string[] }
const { id,title,href,category,x,y,size,related } = Astro.props;
const points = Array.from({ length: 6 }, (_, i) => {
  const angle = (Math.PI / 3) * i - Math.PI / 6;
  return `${x + size * Math.cos(angle)},${y + size * Math.sin(angle)}`;
}).join(' ');
const css = categoryMeta[category]?.css ?? 'cat-01';
---
<a class={`mosaic-cell ${css}`} href={href} data-scenario-id={id} data-related={related.join(',')} aria-label={`${id}: ${title}`}>
  <polygon points={points} vector-effect="non-scaling-stroke" />
  <title>{`${id}: ${title}`}</title>
</a>
