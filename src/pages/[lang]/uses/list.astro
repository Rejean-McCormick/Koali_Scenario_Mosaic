---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLocalizedScenarios } from '../../../lib/scenarios';
import { locales, getUi, type Locale } from '../../../i18n/ui';
export function getStaticPaths(){ return locales.map((lang) => ({ params:{lang} })); }
const locale = Astro.params.lang as Locale;
const strings = getUi(locale);
const scenarios = await getLocalizedScenarios(locale);
---
<BaseLayout locale={locale} title={`${strings.allScenarios} | Koali`}>
  <section style="max-width:900px;margin:auto;padding:2rem">
    <h1>{strings.allScenarios}</h1>
    {scenarios.map((scenario:any) => <p><a href={`/${locale}/uses/${scenario.data.id}/`}>{scenario.data.id} — {scenario.data.title}</a></p>)}
  </section>
</BaseLayout>
