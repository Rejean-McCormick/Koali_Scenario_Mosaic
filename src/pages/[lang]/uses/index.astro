---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScenarioMosaic from '../../../components/ScenarioMosaic.astro';
import { getLocalizedScenarios } from '../../../lib/scenarios';
import { locales, type Locale } from '../../../i18n/ui';
import '../../../styles/mosaic.css';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const scenarios = await getLocalizedScenarios(locale);
---
<BaseLayout locale={locale}>
  <ScenarioMosaic scenarios={scenarios} locale={locale} />
</BaseLayout>
