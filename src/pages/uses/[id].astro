---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicActivities, humanizePublicValue, publicActivityGroups } from '../../lib/public-profile';
import '../../styles/scenario.css';

export const getStaticPaths: GetStaticPaths = async () => {
  const scenarios = await getCollection('scenarios');
  return scenarios.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = (await getCollection('scenarios')).sort((a,b) => a.data.id.localeCompare(b.data.id));
const idx = all.findIndex((x) => x.data.id === entry.data.id);
const prev = idx > 0 ? all[idx-1] : null;
const next = idx < all.length-1 ? all[idx+1] : null;
const activities = getPublicActivities(entry.data.palette);
const scales = (entry.data.scales ?? []).map(humanizePublicValue).join(' · ') || '—';
const contextValues = [...new Set([...(entry.data.settings ?? []), ...(entry.data.domains ?? [])])].map(humanizePublicValue);
const context = contextValues.slice(0, 4).join(' · ') || '—';
const properties = (entry.data.properties ?? []).map(humanizePublicValue).join(' · ') || 'None highlighted';
---
<BaseLayout title={`${entry.data.id} — ${entry.data.title} | Koali Use Mosaic`} description={entry.data.preview_summary} bodyClass="scenario-page">
  <article class="scenario-shell">
    <a class="back-link" href="/uses/">← Back to mosaic</a>
    <header class="scenario-hero">
      <div>
        <p class="scenario-kicker">{entry.data.id} · {entry.data.category_label}</p>
        <h1>{entry.data.title}</h1>
        <p class="scenario-dek">{entry.data.preview_summary}</p>
        <div class="scenario-tags">{entry.data.palette.map((x:string)=><span>{x.replace(/[-_]+/g, ' ')}</span>)}</div>
      </div>
      <img src={entry.data.preview_image} alt={entry.data.preview_image_alt} width="960" height="540" />
    </header>

    <section class="scenario-facts" aria-label="Scenario profile">
      <div><strong>Typical motion</strong><span>{entry.data.pattern_label}</span></div>
      <div><strong>Scale</strong><span>{scales}</span></div>
      <div><strong>Context</strong><span>{context}</span></div>
      <div><strong>Special conditions</strong><span>{properties}</span></div>
    </section>

    <section class="scenario-activities" aria-label="What happens in this scenario">
      <strong>What happens here</strong>
      <div>
        {publicActivityGroups.map((group) => (
          <span class:list={['scenario-activity', { 'is-active': activities[group.key] }]}>
            <i aria-hidden="true"></i>{group.label}
          </span>
        ))}
      </div>
    </section>

    <div class="scenario-body"><Content /></div>
    <nav class="scenario-nav" aria-label="Scenario navigation">
      {prev ? <a href={`/uses/${prev.data.id}/`}><span>Previous</span><strong>{prev.data.title}</strong></a> : <span />}
      {next ? <a href={`/uses/${next.data.id}/`}><span>Next</span><strong>{next.data.title}</strong></a> : <span />}
    </nav>
  </article>
</BaseLayout>
