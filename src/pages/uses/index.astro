---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UsageMosaic from '../../components/UsageMosaic.astro';
import '../../styles/mosaic.css';
const scenarios = (await getCollection('scenarios')).sort((a,b) => a.data.id.localeCompare(b.data.id));
---
<BaseLayout bodyClass="mosaic-page">
  <UsageMosaic scenarios={scenarios} />
</BaseLayout>
