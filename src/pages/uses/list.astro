---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';const s=(await getCollection('scenarios')).sort((a,b)=>a.data.id.localeCompare(b.data.id));
---
<BaseLayout title="All scenarios"><section style="max-width:900px;margin:auto;padding:2rem">{s.map(x=><p><a href={`/uses/${x.data.id}/`}>{x.data.id} — {x.data.title}</a></p>)}</section></BaseLayout>
