---
import '../styles/global.css';
interface Props { title?: string; description?: string; bodyClass?: string; }
const { title='Koali Use Mosaic', description='Explore concrete ways Koali can connect knowledge, people, decisions, work and memory.', bodyClass='' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0d13" />
  <title>{title}</title>
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/uses/" aria-label="Koali Use Mosaic home"><span class="brand-mark" aria-hidden="true">⬡</span><span>KOALI <strong>USE MOSAIC</strong></span></a>
    <nav><a href="/uses/">Mosaic</a><a href="/uses/list/">All scenarios</a></nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="site-footer"><span>Koali Use Mosaic · editorial usage scenarios</span><span>Static-first reference implementation</span></footer>
</body>
</html>
